<script type="text/javascript">
	$(document).ready(function() {
		$("#mysearch").on("change", function() {
			var data = $('#mysearch').find("option:selected").val();
			console.log(data);
			SearchData(data)
		});
	});
	function SearchData(data) {
		if (data.toUpperCase() == 'ALL') {
			$('#myTable tbody tr').show();
		} else {
			$('#myTable tbody tr:has(td)').each(
					function() {
						// 只取第一個字元來判斷符號
						var rowFut = $.trim($(this).find('td:eq(4)').text()).substring(0, 1);
						var rowOPT = $.trim($(this).find('td:eq(5)').text()).substring(0, 1);
						var rowOPTweekly = $.trim($(this).find('td:eq(6)').text()).substring(0, 1);
						// 移除千分位逗號後再比對數字
						var rowSUS = $.trim($(this).find('td:eq(11)').text()).replace(/,/g, '');
						
						var rowETFTWSE = $.trim($(this).find('td:eq(9)').text()).substring(0, 1);						
						var rowETFTPEx = $.trim($(this).find('td:eq(10)').text()).substring(0, 1);
						

						if (data.toUpperCase() == 'FUT100' && rowFut == '●'
								&& rowSUS == '100') {
							$(this).show();
						} else if (data.toUpperCase() == 'FUT2000'
								&& rowFut == '●' && rowSUS == '2000') {
							$(this).show();
						} else if (data.toUpperCase() == 'FUT10000'
								&& rowFut == '●' && rowSUS == '10000') {
							$(this).show();
						} else if (data.toUpperCase() == 'OPT2000'
								&& rowOPT == '●' && rowSUS == '2000') {
							$(this).show();
						} else if (data.toUpperCase() == 'OPT100'
								&& rowOPT == '●' && rowSUS == '100') {
							$(this).show();
						} else if (data.toUpperCase() == 'OPT10000'
								&& rowOPT == '●' && rowSUS == '10000') {
							$(this).show();
						} else if (data.toUpperCase() == 'ETF1000'
							&& rowSUS == '1000'  && (rowETFTWSE == '◎' || rowETFTPEx == '◎')){
						     $(this).show();						
					
						} else if (data.toUpperCase() == 'OPTWEEKLY' && rowOPTweekly == '●') {
							$(this).show();
						}else {
							$(this).hide();
						}

					});
		}
		if (data.toUpperCase() == 'FUT100') {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/StockProducts/FuturesMini100/" title="小型個股期貨報價(另開視窗)" target="_blank">小型個股期貨報價</a>');
		} else if (data.toUpperCase() == 'FUT2000') {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/StockProducts/HotStockFutures/" title="個股期貨報價(另開視窗)" target="_blank">個股期貨報價</a>');
		} else if (data.toUpperCase() == 'FUT10000') {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/EtfProducts/HotEtfFutures/" title="ETF期貨報價(另開視窗)" target="_blank">ETF期貨報價</a>');
		} else if (data.toUpperCase() == 'ETF1000') {
			$('#linkstok')
			.html(
					'<a href="https://mis.taifex.com.tw/futures/RegularSession/EtfProducts/HotEtfFutures/" title="ETF期貨報價(另開視窗)" target="_blank">ETF期貨報價</a>');
        } else if (data.toUpperCase() == 'OPT2000' || data.toUpperCase() == 'OPT100' || data.toUpperCase() == 'OPTWEEKLY') {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/StockProducts/Options/" title="個股選擇權報價(另開視窗)" target="_blank">個股選擇權報價</a>');
		} else if (data.toUpperCase() == 'OPT10000') {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/EtfProducts/Options/" title="ETF選擇權報價(另開視窗)" target="_blank">ETF選擇權報價</a>');
		} else {
			$('#linkstok')
					.html(
							'<a href="https://mis.taifex.com.tw/futures/RegularSession/StockProducts/HotStockFutures/" title="個股期貨報價(另開視窗)" target="_blank">個股期貨報價</a>');
		}

	}
</script>